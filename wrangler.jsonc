{
  // Cloudflare Workers static-assets config for blackindieromance.com.
  // The site is fully static: `npm run build` writes it to dist/, and
  // `npx wrangler deploy` uploads that folder.
  "name": "blackindieromance",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
