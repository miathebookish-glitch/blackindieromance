---
import { HEAT_LEVELS } from '../lib/site';
interface Props { level: number; label?: boolean; size?: number }
const { level, label = true, size = 18 } = Astro.props;
const name = HEAT_LEVELS.find((h) => h.level === level)?.name ?? '';
---
<span class="heat">
  <span class="visually-hidden">Heat {level} of 5{name ? `, ${name}` : ''}</span>
  {[1, 2, 3, 4, 5].map((i) => (
    <svg class={i <= level ? 'on' : 'off'} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2c1.2 3.2 4.5 5.3 4.5 9.6a4.5 4.5 0 0 1-9 0c0-2.1 1-3.5 2.2-4.6 0 2 .9 3.2 2.1 3.4.2-3-.8-5.4.2-8.4z" />
    </svg>
  ))}
  {label && <span class="heat-label" aria-hidden="true">Heat {level}/5</span>}
</span>
