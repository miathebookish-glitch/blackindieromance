---
const links = [
  { href: '/lists/', label: 'Book lists' },
  { href: '/tropes/', label: 'Tropes' },
  { href: '/heat/', label: 'Heat level' },
  { href: '/free-in-ku/', label: 'Free in KU' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/">Black Indie <em>Romance</em></a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
